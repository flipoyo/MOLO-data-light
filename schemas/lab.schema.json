{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molonari.example/schemas/lab.schema.json",
  "title": "MOLONARI virtual lab",
  "type": "object",
  "required": [
    "schema",
    "calibrations",
    "sampling_points"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "calibrations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "beta",
          "v_ref",
          "intercept",
          "dudh",
          "dudt"
        ],
        "properties": {
          "beta": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "v_ref": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "intercept": {
            "type": "number"
          },
          "dudh": {
            "type": "number",
            "not": {
              "const": 0
            }
          },
          "dudt": {
            "type": "number"
          },
          "t0_k": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "thermal_calibrations": {
      "type": "object",
      "description": "Registre indexé par génération matérielle ; fichiers sous calibration/thermal/.",
      "additionalProperties": {
        "$ref": "#/$defs/thermalCalibrationSpec"
      }
    },
    "sampling_points": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "calibration"
        ],
        "properties": {
          "calibration": {
            "type": "string"
          },
          "hardware_generation": {
            "type": "string"
          },
          "thermal_calibration": {
            "oneOf": [
              {
                "type": "string",
                "description": "Identifiant dans thermal_calibrations."
              },
              {
                "$ref": "#/$defs/thermalCalibrationSpec"
              }
            ]
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "params": {
            "type": "object"
          },
          "v1": {
            "type": "object"
          },
          "v2": {
            "type": "object"
          },
          "legacy_csv": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "thermalCalibrationSpec": {
      "type": "object",
      "required": [
        "table"
      ],
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "object",
          "required": [
            "external",
            "internal",
            "pressure"
          ],
          "properties": {
            "external": {
              "type": "string"
            },
            "internal": {
              "type": "string"
            },
            "pressure": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "external_series": {
          "type": "string"
        },
        "dt_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
